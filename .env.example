# Postgres connection string. On Vercel, adding Neon from the Marketplace sets this for you.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Public URL of the app, used to build magic links (never derived from request headers).
APP_URL=https://your-app.vercel.app

# The first admin. Created automatically on first request.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name

# Display settings
GROUP_NAME=Pickleball
NEXT_PUBLIC_CURRENCY=AUD
TIMEZONE=Australia/Perth

# SMTP for magic links (e.g. Gmail: smtp.gmail.com / 465 / your address / an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="Pickleball <you@gmail.com>"

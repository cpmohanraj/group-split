# Postgres. On Vercel, connecting Neon from Storage sets this for you.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Google sign-in (Google Cloud Console → Google Auth Platform → Clients → Web application).
# Authorised redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=set-me-as-a-sensitive-variable

# Public URL of the app. Used for the OAuth redirect; never derived from request headers.
# Optional on Vercel (falls back to the production domain).
APP_URL=https://your-app.vercel.app

# The first admin (must be a Google account email). Created automatically on first request.
ADMIN_EMAIL=you@gmail.com
ADMIN_NAME=Your Name

# Display
GROUP_NAME=Pickleball
NEXT_PUBLIC_CURRENCY=AUD
TIMEZONE=Australia/Perth

# Local development only: enables /auth/dev?email=... (ignored unless NODE_ENV=development)
# DEV_LOGIN=1
